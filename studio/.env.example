# Decart API key — server-side only; the browser gets short-lived session tokens
# minted by /api/decart/token. Each realtime session is billed per second.
DECART_API_KEY=

# fal.ai key — optional, for batch (non-realtime) video editing experiments.
FAL_API_KEY=

# --- Billing (Stripe) --------------------------------------------------------
# First minute of hosted-API studio time is free; after that, sessions require
# an active $20/month Studio Pro subscription.
#
# STRIPE_SECRET_KEY: sk_test_... (test mode) or sk_live_... (production).
# STRIPE_PRICE_ID:   a recurring $20/month price. Create one in the Stripe
#                    dashboard, or run `node scripts/stripe-bootstrap.mjs`
#                    to create the product+price and print this value.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=

# HMAC secret for the signed entitlement cookies (free-minute meter +
# subscription claim). REQUIRED in production — generate with:
#   openssl rand -hex 32
SESSION_SECRET=

# Public origin used in Stripe redirect URLs when deployed behind a proxy/CDN
# (e.g. https://studio.example.com). Optional locally.
PUBLIC_BASE_URL=

# Operator bypass: visiting /api/billing/owner?key=<OWNER_KEY> plants an
# unlimited owner entitlement cookie on that browser (no Stripe). Generate:
#   openssl rand -hex 24
# Leave unset to disable the endpoint entirely (it 404s).
OWNER_KEY=
