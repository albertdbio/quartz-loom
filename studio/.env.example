# Decart API key — server-side only; the browser gets short-lived session tokens
# minted by /api/decart/token. Each realtime session is billed per second.
DECART_API_KEY=

# fal.ai key — optional, for batch (non-realtime) video editing experiments.
FAL_API_KEY=

# --- Billing (Stripe) --------------------------------------------------------
# First minute of hosted-API studio time is free; after that, sessions require
# an active $20/month Studio Pro subscription.
#
# STRIPE_SECRET_KEY: sk_test_... (test mode) or sk_live_... (production).
# STRIPE_PRICE_ID:   a recurring $20/month price. Create one in the Stripe
#                    dashboard, or run `node scripts/stripe-bootstrap.mjs`
#                    to create the product+price and print this value.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=

# HMAC secret for the signed entitlement cookies (free-minute meter +
# subscription claim). REQUIRED in production — generate with:
#   openssl rand -hex 32
SESSION_SECRET=

# Public origin used in Stripe redirect URLs when deployed behind a proxy/CDN
# (e.g. https://studio.example.com). Optional locally.
PUBLIC_BASE_URL=

# Operator bypass: visiting /api/billing/owner?key=<OWNER_KEY> plants an
# unlimited owner entitlement cookie on that browser (no Stripe). Generate:
#   openssl rand -hex 24
# Leave unset to disable the endpoint entirely (it 404s).
OWNER_KEY=

# --- Phone sign-in (Twilio) --------------------------------------------------
# Same Twilio ACCOUNT + API key as mochi/core, but its OWN sender number:
# replies to mochi's number are answered by mochi's agent, so a shared number
# would route a Magic Wand user's "STOP" into a different product.
# v1 is outbound-only (the code is typed into the app, never replied to), so no
# inbound webhook is needed — Twilio answers STOP/HELP on the number itself.
#
# US A2P 10DLC — ALREADY SOLVED, reuse it. The account's brand is APPROVED /
# VETTED_VERIFIED and its campaign QE2c6890da8086d771620e9b13fadeba0b is a
# VERIFIED **MIXED** campaign described as "one-time passcodes, notifications,
# updates", whose registered sample message is literally "Your one-time
# passcode is 123456." Our OTP is exactly the registered content, so it needs
# NO new campaign and no new vetting.
#
# What you DO need: attach this app's sender number to that same campaign
# (messaging service MGe0a8243a58c015290a6d6a308e2675b2). Use a number that
# mochi isn't already answering on — the account's two existing numbers are
# taken (consumer Mochi + Meta Mochi) and their inbound webhooks point at
# mochi's agent.
#
# Before sending anything PROMOTIONAL ("new spells and tips"), update that
# campaign's description/samples to cover marketing content — the current
# description mentions only passcodes/notifications/updates, and carriers audit
# traffic against it. Editing the existing campaign beats registering a new one.
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_FROM_NUMBER=

# Engagement list (node:sqlite file). Holds the HMAC pseudonym for everyone who
# signs in, and the dialable number ONLY for those who ticked consent.
SUBSCRIBERS_DB=.data/subscribers.db

# Payments switch. MVP ships "false": a phone-verified account is the
# entitlement. Flip to "true" to activate the Stripe paths (already built and
# tested) — the paywall replaces the sign-in sheet automatically.
PAYMENTS_ENABLED=false
