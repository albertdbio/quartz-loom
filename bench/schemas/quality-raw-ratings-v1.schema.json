{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quality-raw-ratings-v1.schema.json",
  "title": "Judge-returned blind quality ratings v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "protocol_sha256",
    "manifest_sha256",
    "blind_plan_sha256",
    "family_id",
    "rater_id",
    "pass_id",
    "raw_evidence_sha256",
    "ratings"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "protocol_sha256": {"$ref": "#/$defs/sha256"},
    "manifest_sha256": {"$ref": "#/$defs/sha256"},
    "blind_plan_sha256": {"$ref": "#/$defs/sha256"},
    "family_id": {"type": "string", "minLength": 1},
    "rater_id": {"type": "string", "minLength": 1},
    "pass_id": {"type": "integer", "minimum": 1},
    "raw_evidence_sha256": {"$ref": "#/$defs/sha256"},
    "ratings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "blind_id",
          "media_sha256",
          "scores",
          "first_third_quality",
          "final_third_quality",
          "failure_tags",
          "rationale"
        ],
        "properties": {
          "blind_id": {"type": "string", "pattern": "^[0-9a-f]{20}$"},
          "media_sha256": {"$ref": "#/$defs/sha256"},
          "scores": {"$ref": "#/$defs/scores"},
          "first_third_quality": {"$ref": "#/$defs/score"},
          "final_third_quality": {"$ref": "#/$defs/score"},
          "failure_tags": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string"}
          },
          "rationale": {"type": "string", "minLength": 1}
        }
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "score": {"type": "number", "minimum": 1, "maximum": 10},
    "scores": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prompt_adherence",
        "spatial_fidelity",
        "identity_consistency",
        "motion_naturalness",
        "temporal_artifacts"
      ],
      "properties": {
        "prompt_adherence": {"$ref": "#/$defs/score"},
        "spatial_fidelity": {"$ref": "#/$defs/score"},
        "identity_consistency": {"$ref": "#/$defs/score"},
        "motion_naturalness": {"$ref": "#/$defs/score"},
        "temporal_artifacts": {"$ref": "#/$defs/score"}
      }
    }
  }
}
