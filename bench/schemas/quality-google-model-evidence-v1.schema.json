{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quality-google-model-evidence-v1.schema.json",
  "title": "Scrubbed Gemini 3.1 Pro blind-video response evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "provider",
    "model_id",
    "endpoint",
    "protocol_sha256",
    "manifest_sha256",
    "blind_plan_sha256",
    "family_id",
    "rater_id",
    "pass_id",
    "records"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "provider": {"const": "google"},
    "model_id": {"const": "gemini-3.1-pro-preview"},
    "endpoint": {
      "const": "https://generativelanguage.googleapis.com/v1beta/models/gemini-3.1-pro-preview:generateContent"
    },
    "protocol_sha256": {"$ref": "#/$defs/sha256"},
    "manifest_sha256": {"$ref": "#/$defs/sha256"},
    "blind_plan_sha256": {"$ref": "#/$defs/sha256"},
    "family_id": {"type": "string", "minLength": 1},
    "rater_id": {"const": "gemini-3.1-pro-preview"},
    "pass_id": {"type": "integer", "minimum": 1},
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/evidenceRecord"}
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "enumCode": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
    },
    "evidenceRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "endpoint",
        "model_id",
        "blind_id",
        "asset_id",
        "media_sha256",
        "request",
        "raw_response",
        "raw_response_sha256"
      ],
      "properties": {
        "schema_version": {"const": 1},
        "endpoint": {
          "const": "https://generativelanguage.googleapis.com/v1beta/models/gemini-3.1-pro-preview:generateContent"
        },
        "model_id": {"const": "gemini-3.1-pro-preview"},
        "blind_id": {"type": "string", "pattern": "^[0-9a-f]{20}$"},
        "asset_id": {"type": "string", "pattern": "^asset-[0-9a-f]{20}$"},
        "media_sha256": {"$ref": "#/$defs/sha256"},
        "request": {"$ref": "#/$defs/request"},
        "raw_response": {"$ref": "#/$defs/rawResponse"},
        "raw_response_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "endpoint",
        "model_id",
        "adapter_sha256",
        "blind_id",
        "asset_id",
        "media_sha256",
        "prompt_sha256",
        "rubric_sha256",
        "response_schema_sha256",
        "temperature",
        "max_tokens",
        "video_fps",
        "stream",
        "wire_request"
      ],
      "properties": {
        "endpoint": {
          "const": "https://generativelanguage.googleapis.com/v1beta/models/gemini-3.1-pro-preview:generateContent"
        },
        "model_id": {"const": "gemini-3.1-pro-preview"},
        "adapter_sha256": {"$ref": "#/$defs/sha256"},
        "blind_id": {"type": "string", "pattern": "^[0-9a-f]{20}$"},
        "asset_id": {"type": "string", "pattern": "^asset-[0-9a-f]{20}$"},
        "media_sha256": {"$ref": "#/$defs/sha256"},
        "prompt_sha256": {"$ref": "#/$defs/sha256"},
        "rubric_sha256": {"$ref": "#/$defs/sha256"},
        "response_schema_sha256": {"$ref": "#/$defs/sha256"},
        "temperature": {"const": 0},
        "max_tokens": {"const": 2048},
        "video_fps": {"const": 16.0},
        "stream": {"const": false},
        "wire_request": {"$ref": "#/$defs/wireRequest"}
      }
    },
    "wireRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contents", "generationConfig"],
      "properties": {
        "contents": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["role", "parts"],
            "properties": {
              "role": {"const": "user"},
              "parts": {
                "type": "array",
                "prefixItems": [
                  {"$ref": "#/$defs/videoPart"},
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["text"],
                    "properties": {"text": {"type": "string", "minLength": 1}}
                  }
                ],
                "minItems": 2,
                "maxItems": 2
              }
            }
          }
        },
        "generationConfig": {
          "type": "object",
          "additionalProperties": false,
          "required": ["temperature", "maxOutputTokens", "responseFormat"],
          "properties": {
            "temperature": {"const": 0},
            "maxOutputTokens": {"const": 2048},
            "responseFormat": {
              "type": "object",
              "additionalProperties": false,
              "required": ["text"],
              "properties": {
                "text": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["mimeType", "schema"],
                  "properties": {
                    "mimeType": {"const": "APPLICATION_JSON"},
                    "schema": {
                      "const": {
                      "type": "object",
                      "properties": {
                        "scores": {
                          "type": "object",
                          "properties": {
                            "prompt_adherence": {"type": "integer", "minimum": 1, "maximum": 10},
                            "spatial_fidelity": {"type": "integer", "minimum": 1, "maximum": 10},
                            "identity_consistency": {"type": "integer", "minimum": 1, "maximum": 10},
                            "motion_naturalness": {"type": "integer", "minimum": 1, "maximum": 10},
                            "temporal_artifacts": {"type": "integer", "minimum": 1, "maximum": 10}
                          },
                          "required": [
                            "prompt_adherence",
                            "spatial_fidelity",
                            "identity_consistency",
                            "motion_naturalness",
                            "temporal_artifacts"
                          ]
                        },
                        "first_third_quality": {"type": "integer", "minimum": 1, "maximum": 10},
                        "final_third_quality": {"type": "integer", "minimum": 1, "maximum": 10},
                        "failure_tags": {"type": "array", "items": {"type": "string"}},
                        "rationale": {"type": "string"}
                      },
                      "required": [
                        "scores",
                        "first_third_quality",
                        "final_third_quality",
                        "failure_tags",
                        "rationale"
                      ]
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "videoPart": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inlineData", "videoMetadata"],
      "properties": {
        "inlineData": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mimeType", "media_sha256", "decoded_bytes", "encoded_bytes"],
          "properties": {
            "mimeType": {"const": "video/mp4"},
            "media_sha256": {"$ref": "#/$defs/sha256"},
            "decoded_bytes": {"type": "integer", "minimum": 1},
            "encoded_bytes": {"type": "integer", "minimum": 1, "maximum": 20000000}
          }
        },
        "videoMetadata": {
          "type": "object",
          "additionalProperties": false,
          "required": ["fps"],
          "properties": {"fps": {"const": 16.0}}
        }
      }
    },
    "rawResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidates",
        "usageMetadata",
        "modelVersion",
        "promptFeedback",
        "responseId"
      ],
      "properties": {
        "candidates": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {"$ref": "#/$defs/candidate"}
        },
        "usageMetadata": {"$ref": "#/$defs/usageMetadata"},
        "modelVersion": {"const": "gemini-3.1-pro-preview"},
        "promptFeedback": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["blockReason", "safetyRatings"],
              "properties": {
                "blockReason": {
                  "oneOf": [{"type": "null"}, {"$ref": "#/$defs/enumCode"}]
                },
                "safetyRatings": {
                  "type": "array",
                  "items": {"$ref": "#/$defs/safetyRating"}
                }
              }
            }
          ]
        },
        "responseId": {"type": "string", "minLength": 1}
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["content", "finishReason", "index", "safetyRatings"],
      "properties": {
        "content": {
          "type": "object",
          "additionalProperties": false,
          "required": ["parts", "role"],
          "properties": {
            "parts": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["text"],
                "properties": {"text": {"type": "string", "minLength": 1}}
              }
            },
            "role": {"const": "model"}
          }
        },
        "finishReason": {"const": "STOP"},
        "index": {"const": 0},
        "safetyRatings": {
          "type": "array",
          "items": {"$ref": "#/$defs/safetyRating"}
        }
      }
    },
    "safetyRating": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "category": {"$ref": "#/$defs/enumCode"},
        "probability": {"$ref": "#/$defs/enumCode"},
        "severity": {"$ref": "#/$defs/enumCode"},
        "probabilityScore": {"type": "number", "minimum": 0, "maximum": 1},
        "severityScore": {"type": "number", "minimum": 0, "maximum": 1},
        "blocked": {"type": "boolean"}
      }
    },
    "usageMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["promptTokenCount", "candidatesTokenCount", "totalTokenCount"],
      "properties": {
        "promptTokenCount": {"type": "integer", "minimum": 0},
        "candidatesTokenCount": {"type": "integer", "minimum": 0},
        "totalTokenCount": {"type": "integer", "minimum": 0},
        "thoughtsTokenCount": {"type": "integer", "minimum": 0},
        "cachedContentTokenCount": {"type": "integer", "minimum": 0}
      }
    }
  }
}
