{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quality-performance-evidence-v1.schema.json",
  "title": "Manifest-bound quality-qualified performance evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "protocol_sha256",
    "selected_system",
    "selection_lock_sha256",
    "confirmatory_manifest_sha256",
    "confirmatory_media_report_sha256",
    "sentinel_manifest_sha256",
    "sentinel_media_report_sha256",
    "selected_run_sha256",
    "sentinel_run_sha256",
    "cold_trial",
    "warm_trials",
    "sentinel_trials",
    "evidence_sha256"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "status": {"const": "complete"},
    "protocol_sha256": {"$ref": "#/$defs/sha256"},
    "selected_system": {"type": "string", "minLength": 1},
    "selection_lock_sha256": {"$ref": "#/$defs/sha256"},
    "confirmatory_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "confirmatory_media_report_sha256": {"$ref": "#/$defs/sha256"},
    "sentinel_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "sentinel_media_report_sha256": {"$ref": "#/$defs/sha256"},
    "selected_run_sha256": {"$ref": "#/$defs/sha256"},
    "sentinel_run_sha256": {"$ref": "#/$defs/sha256"},
    "cold_trial": {"$ref": "#/$defs/shortTrial"},
    "warm_trials": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {"$ref": "#/$defs/shortTrial"}
    },
    "sentinel_trials": {
      "type": "array",
      "minItems": 2,
      "items": {"$ref": "#/$defs/sentinelTrial"}
    },
    "evidence_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "positiveNumber": {"type": "number", "exclusiveMinimum": 0},
    "trialBase": {
      "type": "object",
      "required": [
        "trial_id",
        "media_sha256",
        "wall_started_ns",
        "wall_finished_ns",
        "rgb_ready_ns",
        "e2e_fps",
        "first_visible_rgb_s",
        "p95_effective_frame_interval_ms",
        "forwards",
        "decoded_frames"
      ],
      "properties": {
        "trial_id": {"type": "string", "minLength": 1},
        "media_sha256": {"$ref": "#/$defs/sha256"},
        "wall_started_ns": {"type": "integer", "minimum": 0},
        "wall_finished_ns": {"type": "integer", "minimum": 0},
        "rgb_ready_ns": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "integer", "minimum": 0}
        },
        "e2e_fps": {"$ref": "#/$defs/positiveNumber"},
        "first_visible_rgb_s": {"$ref": "#/$defs/positiveNumber"},
        "p95_effective_frame_interval_ms": {"$ref": "#/$defs/positiveNumber"},
        "forwards": {"type": "integer", "minimum": 1},
        "decoded_frames": {"type": "integer", "minimum": 1}
      }
    },
    "shortTrial": {
      "allOf": [
        {"$ref": "#/$defs/trialBase"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "artifact_id",
            "run_id",
            "prompt_id",
            "seed"
          ],
          "properties": {
            "trial_id": {},
            "media_sha256": {},
            "wall_started_ns": {},
            "wall_finished_ns": {},
            "rgb_ready_ns": {},
            "e2e_fps": {},
            "first_visible_rgb_s": {},
            "p95_effective_frame_interval_ms": {},
            "forwards": {"const": 45},
            "decoded_frames": {"const": 81},
            "artifact_id": {"type": "string", "minLength": 1},
            "run_id": {"type": "string", "minLength": 1},
            "prompt_id": {"type": "string", "minLength": 1},
            "seed": {"type": "integer"}
          }
        }
      ]
    },
    "sentinelTrial": {
      "allOf": [
        {"$ref": "#/$defs/trialBase"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "artifact_id",
            "run_id",
            "prompt_id",
            "seed",
            "media_duration_s"
          ],
          "properties": {
            "trial_id": {},
            "media_sha256": {},
            "wall_started_ns": {},
            "wall_finished_ns": {},
            "rgb_ready_ns": {},
            "e2e_fps": {},
            "first_visible_rgb_s": {},
            "p95_effective_frame_interval_ms": {},
            "forwards": {"const": 485},
            "decoded_frames": {"const": 961},
            "artifact_id": {"type": "string", "minLength": 1},
            "run_id": {"type": "string", "minLength": 1},
            "prompt_id": {"type": "string", "minLength": 1},
            "seed": {"type": "integer"},
            "media_duration_s": {"$ref": "#/$defs/positiveNumber"}
          }
        }
      ]
    }
  }
}
