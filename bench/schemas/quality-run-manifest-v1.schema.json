{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quality-run-manifest-v1.schema.json",
  "title": "Quality sweep exact run manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "protocol_sha256", "scope", "runs", "records"],
  "properties": {
    "schema_version": {"const": 1},
    "protocol_sha256": {"$ref": "#/$defs/sha256"},
    "selection_lock_sha256": {"$ref": "#/$defs/sha256"},
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phase", "system_ids", "cases"],
      "properties": {
        "phase": {
          "enum": [
            "development-round-a",
            "development-round-b",
            "confirmatory",
            "sentinel"
          ]
        },
        "system_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "cases": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["prompt_id", "seed"],
            "properties": {
              "prompt_id": {"type": "string", "minLength": 1},
              "seed": {"type": "integer"}
            }
          }
        }
      }
    },
    "runs": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/run"}
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/record"}
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "scope": {
            "properties": {
              "phase": {"enum": ["confirmatory", "sentinel"]}
            },
            "required": ["phase"]
          }
        },
        "required": ["scope"]
      },
      "then": {"required": ["selection_lock_sha256"]},
      "else": {"not": {"required": ["selection_lock_sha256"]}}
    },
    {
      "if": {
        "properties": {"scope": {"properties": {"phase": {"const": "development-round-a"}}}}
      },
      "then": {"properties": {"records": {"items": {"properties": {"split": {"const": "development-round-a"}}}}}}
    },
    {
      "if": {
        "properties": {"scope": {"properties": {"phase": {"const": "development-round-b"}}}}
      },
      "then": {"properties": {"records": {"items": {"properties": {"split": {"const": "development-round-b"}}}}}}
    },
    {
      "if": {
        "properties": {"scope": {"properties": {"phase": {"const": "confirmatory"}}}}
      },
      "then": {"properties": {"records": {"items": {"properties": {"split": {"const": "confirmatory"}}}}}}
    },
    {
      "if": {
        "properties": {"scope": {"properties": {"phase": {"const": "sentinel"}}}}
      },
      "then": {"properties": {"records": {"items": {"properties": {"split": {"const": "sentinel"}}}}}}
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "nonemptyObject": {"type": "object", "minProperties": 1},
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "system_id",
        "source_commit",
        "source_diff_sha256",
        "checkpoint_revision",
        "checkpoint_sha256",
        "decoder_revision",
        "decoder_sha256",
        "runner_sha256",
        "config_sha256",
        "rubric_sha256",
        "hardware",
        "software",
        "determinism",
        "encoding"
      ],
      "properties": {
        "run_id": {"type": "string", "minLength": 1},
        "system_id": {"type": "string", "minLength": 1},
        "source_commit": {"$ref": "#/$defs/commit"},
        "source_diff_sha256": {"$ref": "#/$defs/sha256"},
        "checkpoint_revision": {"type": "string", "minLength": 1},
        "checkpoint_sha256": {"$ref": "#/$defs/sha256"},
        "decoder_revision": {"type": "string", "minLength": 1},
        "decoder_sha256": {"$ref": "#/$defs/sha256"},
        "runner_sha256": {"$ref": "#/$defs/sha256"},
        "config_sha256": {"$ref": "#/$defs/sha256"},
        "rubric_sha256": {"$ref": "#/$defs/sha256"},
        "hardware": {"$ref": "#/$defs/nonemptyObject"},
        "software": {"$ref": "#/$defs/nonemptyObject"},
        "determinism": {"$ref": "#/$defs/nonemptyObject"},
        "encoding": {"$ref": "#/$defs/nonemptyObject"}
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "run_id",
        "system_id",
        "prompt_id",
        "split",
        "prompt_utf8_sha256",
        "effective_prompt_utf8_sha256",
        "seed",
        "rng_algorithm",
        "rng_device",
        "seed_application_point",
        "initial_noise_sha256",
        "input_noise_sha256",
        "latent_sha256",
        "source_file",
        "media_sha256",
        "runner_sha256",
        "decoder_mode",
        "forwards",
        "decoded_frames",
        "media_contract_id"
      ],
      "properties": {
        "artifact_id": {"type": "string", "minLength": 1},
        "run_id": {"type": "string", "minLength": 1},
        "system_id": {"type": "string", "minLength": 1},
        "prompt_id": {"type": "string", "minLength": 1},
        "split": {
          "enum": [
            "development-round-a",
            "development-round-b",
            "confirmatory",
            "sentinel"
          ]
        },
        "prompt_utf8_sha256": {"$ref": "#/$defs/sha256"},
        "effective_prompt_utf8_sha256": {"$ref": "#/$defs/sha256"},
        "seed": {"type": "integer"},
        "rng_algorithm": {"type": "string", "minLength": 1},
        "rng_device": {"type": "string", "minLength": 1},
        "seed_application_point": {"type": "string", "minLength": 1},
        "initial_noise_sha256": {"$ref": "#/$defs/sha256"},
        "input_noise_sha256": {"$ref": "#/$defs/sha256"},
        "latent_sha256": {"$ref": "#/$defs/sha256"},
        "source_file": {"type": "string", "minLength": 1},
        "media_sha256": {"$ref": "#/$defs/sha256"},
        "runner_sha256": {"$ref": "#/$defs/sha256"},
        "decoder_mode": {"type": "string", "minLength": 1},
        "forwards": {"type": "integer", "minimum": 1},
        "decoded_frames": {"enum": [81, 961]},
        "media_contract_id": {"enum": ["short", "long"]}
      },
      "allOf": [
        {
          "if": {
            "properties": {"split": {"const": "sentinel"}},
            "required": ["split"]
          },
          "then": {
            "properties": {
              "forwards": {"const": 485},
              "decoded_frames": {"const": 961},
              "media_contract_id": {"const": "long"}
            }
          },
          "else": {
            "properties": {
              "decoded_frames": {"const": 81},
              "media_contract_id": {"const": "short"}
            }
          }
        },
        {
          "if": {
            "properties": {
              "split": {"not": {"const": "sentinel"}},
              "system_id": {"const": "sf4-reference"}
            },
            "required": ["split", "system_id"]
          },
          "then": {"properties": {"forwards": {"const": 35}}}
        },
        {
          "if": {
            "properties": {
              "split": {"not": {"const": "sentinel"}},
              "system_id": {"not": {"const": "sf4-reference"}}
            },
            "required": ["split", "system_id"]
          },
          "then": {"properties": {"forwards": {"const": 45}}}
        }
      ]
    }
  }
}
