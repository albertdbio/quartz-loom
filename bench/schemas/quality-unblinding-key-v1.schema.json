{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quality-unblinding-key-v1.schema.json",
  "title": "Operator-only quality unblinding key v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "protocol_sha256",
    "manifest_sha256",
    "blind_plan_sha256",
    "family_id",
    "rater_id",
    "pass_id",
    "blind_secret_sha256",
    "records"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "protocol_sha256": {"$ref": "#/$defs/sha256"},
    "manifest_sha256": {"$ref": "#/$defs/sha256"},
    "blind_plan_sha256": {"$ref": "#/$defs/sha256"},
    "family_id": {"type": "string", "minLength": 1},
    "rater_id": {"type": "string", "minLength": 1},
    "pass_id": {"type": "integer", "minimum": 1},
    "blind_secret_sha256": {"$ref": "#/$defs/sha256"},
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["blind_id", "artifact_id"],
        "properties": {
          "blind_id": {"type": "string", "pattern": "^[0-9a-f]{20}$"},
          "artifact_id": {"type": "string", "minLength": 1}
        }
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
