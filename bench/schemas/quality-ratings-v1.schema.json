{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quality-ratings-v1.schema.json",
  "title": "Quality sweep key-joined normalized ratings v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "protocol_sha256",
    "manifest_sha256",
    "blind_plan_sha256",
    "unblinding_key_sha256",
    "raw_ratings_sha256",
    "raw_evidence_sha256",
    "family_id",
    "rater_id",
    "pass_id",
    "ratings"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "protocol_sha256": {"$ref": "#/$defs/sha256"},
    "manifest_sha256": {"$ref": "#/$defs/sha256"},
    "blind_plan_sha256": {"$ref": "#/$defs/sha256"},
    "unblinding_key_sha256": {"$ref": "#/$defs/sha256"},
    "raw_ratings_sha256": {"$ref": "#/$defs/sha256"},
    "raw_evidence_sha256": {"$ref": "#/$defs/sha256"},
    "family_id": {"type": "string", "minLength": 1},
    "rater_id": {"type": "string", "minLength": 1},
    "pass_id": {"type": "integer", "minimum": 1},
    "ratings": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/rating"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "score": {"type": "number", "minimum": 1, "maximum": 10},
    "scores": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prompt_adherence",
        "spatial_fidelity",
        "identity_consistency",
        "motion_naturalness",
        "temporal_artifacts"
      ],
      "properties": {
        "prompt_adherence": {"$ref": "#/$defs/score"},
        "spatial_fidelity": {"$ref": "#/$defs/score"},
        "identity_consistency": {"$ref": "#/$defs/score"},
        "motion_naturalness": {"$ref": "#/$defs/score"},
        "temporal_artifacts": {"$ref": "#/$defs/score"}
      }
    },
    "rating": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family_id",
        "rater_id",
        "pass_id",
        "blind_id",
        "artifact_id",
        "protocol_sha256",
        "manifest_sha256",
        "blind_plan_sha256",
        "unblinding_key_sha256",
        "raw_ratings_sha256",
        "raw_evidence_sha256",
        "system_id",
        "prompt_id",
        "seed",
        "media_sha256",
        "scores",
        "first_third_quality",
        "final_third_quality",
        "failure_tags",
        "rationale"
      ],
      "properties": {
        "family_id": {"type": "string", "minLength": 1},
        "rater_id": {"type": "string", "minLength": 1},
        "pass_id": {"type": "integer", "minimum": 1},
        "blind_id": {"type": "string", "pattern": "^[0-9a-f]{20}$"},
        "artifact_id": {"type": "string", "minLength": 1},
        "protocol_sha256": {"$ref": "#/$defs/sha256"},
        "manifest_sha256": {"$ref": "#/$defs/sha256"},
        "blind_plan_sha256": {"$ref": "#/$defs/sha256"},
        "unblinding_key_sha256": {"$ref": "#/$defs/sha256"},
        "raw_ratings_sha256": {"$ref": "#/$defs/sha256"},
        "raw_evidence_sha256": {"$ref": "#/$defs/sha256"},
        "system_id": {"type": "string", "minLength": 1},
        "prompt_id": {"type": "string", "minLength": 1},
        "seed": {"type": "integer"},
        "media_sha256": {"$ref": "#/$defs/sha256"},
        "scores": {"$ref": "#/$defs/scores"},
        "first_third_quality": {"$ref": "#/$defs/score"},
        "final_third_quality": {"$ref": "#/$defs/score"},
        "failure_tags": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string"}
        },
        "rationale": {"type": "string", "minLength": 1}
      }
    }
  }
}
