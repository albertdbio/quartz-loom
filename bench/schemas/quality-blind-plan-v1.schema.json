{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quality-blind-plan-v1.schema.json",
  "title": "Judge-visible quality blind plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "protocol_sha256",
    "manifest_sha256",
    "family_id",
    "rater_id",
    "pass_id",
    "records"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "protocol_sha256": {"$ref": "#/$defs/sha256"},
    "manifest_sha256": {"$ref": "#/$defs/sha256"},
    "family_id": {"type": "string", "minLength": 1},
    "rater_id": {"type": "string", "minLength": 1},
    "pass_id": {"type": "integer", "minimum": 1},
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "blind_id",
          "asset_id",
          "case_id",
          "prompt_id",
          "prompt",
          "slot",
          "media_sha256"
        ],
        "properties": {
          "blind_id": {"type": "string", "pattern": "^[0-9a-f]{20}$"},
          "asset_id": {"type": "string", "pattern": "^asset-[0-9a-f]{20}$"},
          "case_id": {"type": "string", "pattern": "^[0-9a-f]{20}$"},
          "prompt_id": {"type": "string", "minLength": 1},
          "prompt": {"type": "string", "minLength": 1},
          "slot": {"type": "string", "pattern": "^[A-Z]$"},
          "media_sha256": {"$ref": "#/$defs/sha256"}
        }
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
