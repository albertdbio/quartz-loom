{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quality-model-evidence-v1.schema.json",
  "title": "Scrubbed blind video-model response evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "provider",
    "model_id",
    "endpoint",
    "protocol_sha256",
    "manifest_sha256",
    "blind_plan_sha256",
    "family_id",
    "rater_id",
    "pass_id",
    "records"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "provider": {"const": "twelvelabs"},
    "model_id": {"const": "pegasus1.5"},
    "endpoint": {"const": "https://api.twelvelabs.io/v1.3/analyze"},
    "protocol_sha256": {"$ref": "#/$defs/sha256"},
    "manifest_sha256": {"$ref": "#/$defs/sha256"},
    "blind_plan_sha256": {"$ref": "#/$defs/sha256"},
    "family_id": {"type": "string", "minLength": 1},
    "rater_id": {"type": "string", "minLength": 1},
    "pass_id": {"type": "integer", "minimum": 1},
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/evidenceRecord"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "evidenceRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "endpoint",
        "model_id",
        "blind_id",
        "asset_id",
        "media_sha256",
        "request",
        "raw_response",
        "raw_response_sha256"
      ],
      "properties": {
        "schema_version": {"const": 1},
        "endpoint": {"const": "https://api.twelvelabs.io/v1.3/analyze"},
        "model_id": {"const": "pegasus1.5"},
        "blind_id": {"type": "string", "pattern": "^[0-9a-f]{20}$"},
        "asset_id": {"type": "string", "pattern": "^asset-[0-9a-f]{20}$"},
        "media_sha256": {"$ref": "#/$defs/sha256"},
        "request": {"$ref": "#/$defs/request"},
        "raw_response": {"type": "object"},
        "raw_response_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "endpoint",
        "model_id",
        "adapter_sha256",
        "blind_id",
        "asset_id",
        "media_sha256",
        "prompt_sha256",
        "rubric_sha256",
        "response_schema_sha256",
        "temperature",
        "max_tokens",
        "stream",
        "wire_request"
      ],
      "properties": {
        "endpoint": {"const": "https://api.twelvelabs.io/v1.3/analyze"},
        "model_id": {"const": "pegasus1.5"},
        "adapter_sha256": {"$ref": "#/$defs/sha256"},
        "blind_id": {"type": "string", "pattern": "^[0-9a-f]{20}$"},
        "asset_id": {"type": "string", "pattern": "^asset-[0-9a-f]{20}$"},
        "media_sha256": {"$ref": "#/$defs/sha256"},
        "prompt_sha256": {"$ref": "#/$defs/sha256"},
        "rubric_sha256": {"$ref": "#/$defs/sha256"},
        "response_schema_sha256": {"$ref": "#/$defs/sha256"},
        "temperature": {"const": 0},
        "max_tokens": {"type": "integer", "minimum": 512},
        "stream": {"const": false},
        "wire_request": {"$ref": "#/$defs/wireRequest"}
      }
    },
    "wireRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_name",
        "video",
        "prompt",
        "temperature",
        "stream",
        "response_format",
        "max_tokens"
      ],
      "properties": {
        "model_name": {"const": "pegasus1.5"},
        "video": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "media_sha256", "decoded_bytes", "encoded_bytes"],
          "properties": {
            "type": {"const": "base64_string"},
            "media_sha256": {"$ref": "#/$defs/sha256"},
            "decoded_bytes": {"type": "integer", "minimum": 1},
            "encoded_bytes": {"type": "integer", "minimum": 1, "maximum": 30000000}
          }
        },
        "prompt": {"type": "string", "minLength": 1},
        "temperature": {"const": 0},
        "stream": {"const": false},
        "response_format": {"type": "object"},
        "max_tokens": {"type": "integer", "minimum": 512}
      }
    }
  }
}
