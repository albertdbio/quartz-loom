{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quality-aggregate-report-v1.schema.json",
  "title": "Complete quality rating aggregate report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "protocol_sha256",
    "manifest_sha256",
    "complete",
    "manifest_phase",
    "selection_lock_sha256",
    "rating_evidence",
    "rating_evidence_sha256",
    "coverage",
    "systems",
    "paired_deltas",
    "n_ratings",
    "report_sha256"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "protocol_sha256": {"$ref": "#/$defs/sha256"},
    "manifest_sha256": {"$ref": "#/$defs/sha256"},
    "complete": {"const": true},
    "manifest_phase": {
      "enum": ["development-round-a", "development-round-b", "confirmatory"]
    },
    "selection_lock_sha256": {
      "oneOf": [
        {"$ref": "#/$defs/sha256"},
        {"type": "null"}
      ]
    },
    "rating_evidence": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/ratingEvidence"}
    },
    "rating_evidence_sha256": {"$ref": "#/$defs/sha256"},
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expected", "observed"],
      "properties": {
        "expected": {"type": "integer", "minimum": 1},
        "observed": {"type": "integer", "minimum": 1}
      }
    },
    "systems": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/systemReport"}
    },
    "paired_deltas": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"type": "number"}
    },
    "n_ratings": {"type": "integer", "minimum": 1},
    "report_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "score": {"type": "number", "minimum": 1, "maximum": 10},
    "scoreMap": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/score"}
    },
    "ratingEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family_id",
        "rater_id",
        "pass_id",
        "blind_plan_sha256",
        "unblinding_key_sha256",
        "raw_ratings_sha256",
        "raw_evidence_sha256"
      ],
      "properties": {
        "family_id": {"type": "string", "minLength": 1},
        "rater_id": {"type": "string", "minLength": 1},
        "pass_id": {"type": "integer", "minimum": 1},
        "blind_plan_sha256": {"$ref": "#/$defs/sha256"},
        "unblinding_key_sha256": {"$ref": "#/$defs/sha256"},
        "raw_ratings_sha256": {"$ref": "#/$defs/sha256"},
        "raw_evidence_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "itemReport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prompt_id",
        "seed",
        "stratum",
        "mean",
        "first_third",
        "final_third",
        "families",
        "early_to_late_drop"
      ],
      "properties": {
        "prompt_id": {"type": "string", "minLength": 1},
        "seed": {"type": "integer"},
        "stratum": {"type": "string", "minLength": 1},
        "mean": {"$ref": "#/$defs/score"},
        "first_third": {"$ref": "#/$defs/score"},
        "final_third": {"$ref": "#/$defs/score"},
        "families": {"$ref": "#/$defs/scoreMap"},
        "early_to_late_drop": {"type": "number"}
      }
    },
    "systemReport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mean",
        "families",
        "n_families",
        "dimensions",
        "items",
        "strata",
        "first_third_mean",
        "final_third_mean",
        "early_to_late_drop",
        "low_quality_item_threshold",
        "low_quality_items"
      ],
      "properties": {
        "mean": {"$ref": "#/$defs/score"},
        "families": {"$ref": "#/$defs/scoreMap"},
        "n_families": {"type": "integer", "minimum": 1},
        "dimensions": {"$ref": "#/$defs/scoreMap"},
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/itemReport"}
        },
        "strata": {"$ref": "#/$defs/scoreMap"},
        "first_third_mean": {"$ref": "#/$defs/score"},
        "final_third_mean": {"$ref": "#/$defs/score"},
        "early_to_late_drop": {"type": "number"},
        "low_quality_item_threshold": {"$ref": "#/$defs/score"},
        "low_quality_items": {"type": "integer", "minimum": 0}
      }
    }
  }
}
