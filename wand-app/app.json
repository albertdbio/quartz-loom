{
  "expo": {
    "name": "Magic Wand",
    "slug": "magic-wand",
    "version": "1.0.0",
    "description": "Touch anything, transform it. Point your camera at the real world and watch whatever you touch turn to gold, ice, pixels, or paint — live.",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#07070d",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a0714"
    },
    "ios": {
      "bundleIdentifier": "video.realtime.magicwand",
      "infoPlist": {
        "NSCameraUsageDescription": "Magic Wand uses the camera so the things you touch can transform live.",
        "NSMicrophoneUsageDescription": "Magic Wand can use the microphone for voice-cast spells.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      },
      "appleTeamId": "THRN2A465Z"
    },
    "android": {
      "package": "video.realtime.magicwand",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.INTERNET",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0a0714"
      }
    },
    "extra": {
      "wandUrl": "https://studio-wand.vercel.app/wand"
    }
  }
}
