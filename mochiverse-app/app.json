{
  "expo": {
    "name": "Mochiverse",
    "slug": "mochiverse",
    "version": "1.0.0",
    "description": "Touch anything and watch it transform. Point your camera at the real world, reach out, and whatever you touch turns to gold, ice, pixels, or flowers \u2014 live.",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#07070d",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a0714"
    },
    "ios": {
      "bundleIdentifier": "io.mochiverse.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Mochiverse uses the camera so the things you touch can transform live.",
        "NSMicrophoneUsageDescription": "Mochiverse can use the microphone for voice transforms.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      },
      "appleTeamId": "THRN2A465Z"
    },
    "android": {
      "package": "io.mochiverse.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.INTERNET",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0a0714"
      }
    },
    "extra": {
      "appUrl": "https://mochiverse.io/"
    },
    "scheme": "mochiverse"
  }
}
